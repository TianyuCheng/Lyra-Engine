    "abseil",
    "cxxopts",
    {
      "name": "d3d12-memory-allocator",
      "platform": "windows"
    },
    "doctest",
    "efsw",
    "entt",
    "etl",
    "fmt",
    "glfw3",
    "gli",
    "glm",
    "ktx",
    "libassert",
    "magic-enum",
    "miniz",
    "nlohmann-json",
    "physfs",
    "shader-slang",
    "spdlog",
    "stb",
    "tinyexr",
    "tinygltf",
    "tinyobjloader",
    "tomlplusplus",
    "volk",
    "vulkan-headers",
    "vulkan-memory-allocator",
    "nativefiledialog-extended",
    {
      "name": "embree",
      "default-features": false,
      "features": [
        "geometry-triangle",
        "geometry-instance",
        "ray-mask"
      ]
    },
    {
      "name": "joltphysics",
      "features": [
        "debugrenderer"
      ]
    }
  ],
  "overrides": [
    {
      "name": "doctest",
      "version": "2.4.12"
    }
  ]
